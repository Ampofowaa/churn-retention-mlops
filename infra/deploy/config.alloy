// infra/deploy/config.alloy — Grafana Alloy: scrapes serving/app.py's
// GET /metrics inside this same compose network, remote_writes to Grafana
// Cloud. Delivered to the box the same way compose.prod.yml/Caddyfile are
// (Terraform seeds it once via aws_s3_object, cd.yml re-syncs it on every
// deploy — see infra/compute.tf's deploy_config_files map).
//
// job_name is pinned to "api" explicitly, not left to Alloy's component-
// label default, because docs/PHASE_12A_TODO.md Group 12's planned alert
// rules (up{job="api"}==0, absent(up{job="api"})) depend on that exact
// label value.
//
// GRAFANA_ENDPOINT/GRAFANA_API_KEY come from the two SSM params
// refresh-env.sh already renders into .env (infra/ssm.tf) — still
// "REPLACE_ME" until pulled from the Grafana Cloud console by hand (Group
// 12's own checklist item, deliberately not done here).
//
// Auth assumption, unverified against a real Grafana Cloud stack (no
// credentials available while writing this): a Grafana Cloud Access Policy
// token authenticates remote_write as a bearer token alone, no separate
// username/instance-ID needed. If the real key turns out to be a classic
// Grafana Cloud API key instead (HTTP basic auth, username = numeric stack
// instance ID), swap bearer_token below for a basic_auth { username =
// ... ; password = ... } block and add a third SSM param for the username
// — a one-line change, not a redesign.

prometheus.scrape "api" {
	targets = [
		{"__address__" = "api:8000"},
	]
	metrics_path    = "/metrics"
	scrape_interval = "30s"
	job_name        = "api"
	forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.remote_write "grafana_cloud" {
	endpoint {
		url = sys.env("GRAFANA_ENDPOINT")

		bearer_token = sys.env("GRAFANA_API_KEY")
	}
}
